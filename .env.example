# Set this only on the server or deployment platform. It is never sent to the browser.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=HackFusion Multi-Talented Agent

# Optional direct provider keys. Keep these server-side and never paste them into chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.8 Flash is prioritized for coding, research, documents, and visual analysis.
# "medium" is recommended for normal complex work; "high" is reserved for Deep/Maximum verification.
GEMINI_COMPLEX_THINKING_LEVEL=medium
GEMINI_DEEP_THINKING_LEVEL=high
# Includes Gemini thinking tokens. Use a larger budget for complex coding so the answer is not cut off mid-reasoning.
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_COMPLEX_MAX_OUTPUT_TOKENS=8192
# Final Gemini review retains complex implementation detail instead of shrinking it to a summary.
GEMINI_REVIEW_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# A demo fallback is used only when no OpenRouter key is configured.
DEMO_MODE=true
PORT=3000
MODEL_COUNT=5
MAX_MODEL_CALLS=8
MIN_SUCCESSFUL_MODELS=3
MAX_CONCURRENT_MODEL_CALLS=2
MAX_RETRIES=2
# Maximum deterministic correction and re-verification attempts per run.
MAX_CORRECTION_LOOPS=2
MAX_ROUNDS=5
MODEL_TIMEOUT_MS=45000
# Per-model completion budgets. Complex work receives enough room for code, tests, and explanation.
MODEL_OUTPUT_TOKENS=1600
COMPLEX_MODEL_OUTPUT_TOKENS=4096
# Controls how much of a completed answer is shown in the result view. The raw model perspective remains in the audit.
FINAL_ANSWER_MAX_CHARS=6000
COMPLEX_FINAL_ANSWER_MAX_CHARS=20000
OPENROUTER_ALLOW_PAID_MODELS=false
MAX_INPUT_CHARS=16000
MAX_DOCUMENT_CHARS=30000
MAX_FILE_BYTES=1048576
CONFIDENCE_THRESHOLD=0.80
EVIDENCE_THRESHOLD=0.70
CONTRADICTION_THRESHOLD=0.35
# Smart routing adds independent perspectives when disagreement reaches this share.
ADAPTIVE_DISAGREEMENT_THRESHOLD=0.35
SANDBOX_ENABLED=false
SANDBOX_IMAGE=node:22-alpine
ADMIN_TOKEN=
